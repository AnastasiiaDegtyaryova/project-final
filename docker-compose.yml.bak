services:
  postgres-jira-prod:
    image: postgres:16
    container_name: postgres-jira-prod
    environment:
      POSTGRES_DB: jira
      POSTGRES_USER: jira
      POSTGRES_PASSWORD: JiraRush
    ports:
      - "5434:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U jira -d jira"]
      interval: 5s
      timeout: 3s
      retries: 10

  postgres-jira-test:
    image: postgres:16
    container_name: postgres-jira-test
    environment:
      POSTGRES_DB: jira-test
      POSTGRES_USER: jira
      POSTGRES_PASSWORD: JiraRush
    ports:
      - "5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U jira -d jira-test"]
      interval: 5s
      timeout: 3s
      retries: 10
